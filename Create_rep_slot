# Create replication slots if not exist on the new primary
echo "🔄 Checking and creating replication slots on $NEW_PRIMARY_NODE_HOST if missing..."

psql -U postgres -h "$NEW_PRIMARY_NODE_HOST" -p "$NEW_PRIMARY_NODE_PORT" -c "SELECT slot_name FROM pg_replication_slots;" | grep -q "$SLOT01"
if [ $? -ne 0 ]; then
  echo "➕ Creating slot $SLOT01"
  psql -U postgres -h "$NEW_PRIMARY_NODE_HOST" -p "$NEW_PRIMARY_NODE_PORT" -c "SELECT * FROM pg_create_physical_replication_slot('$SLOT01');"
fi

...
